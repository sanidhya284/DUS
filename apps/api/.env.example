# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
API_BASE_URL=https://your-api.railway.app

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://...
MONGO_DB_NAME=dus

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://...
REDIS_PASSWORD=

# ─── JWT (RS256) ──────────────────────────────────────────────────────────────
# In production: set JWT_PRIVATE_KEY and JWT_PUBLIC_KEY as base64-encoded PEM strings
# Generate: base64 -i keys/private.pem | tr -d '\n'
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Short code ───────────────────────────────────────────────────────────────
SHORT_CODE_LENGTH=6
SHORT_CODE_BASE_URL=https://your-api.railway.app

# ─── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_ANON=5
RATE_LIMIT_MAX_FREE=30
RATE_LIMIT_MAX_PRO=100

# ─── BullMQ ───────────────────────────────────────────────────────────────────
BULL_CONCURRENCY=10

# ─── GeoIP (optional) ────────────────────────────────────────────────────────
GEOIP_DB_PATH=../../data/GeoLite2-Country.mmdb

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGIN=https://your-app.vercel.app

# ─── Optional: Google Safe Browsing ──────────────────────────────────────────
GOOGLE_SAFE_BROWSING_API_KEY=
