# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# LOCAL: use this for local mongod with replica set
#MONGO_URI=mongodb://localhost:27017/dus?replicaSet=rs0
# ATLAS: replace <db_password> with your actual Atlas password
MONGO_URI=mongodb+srv://dbUser0:zLw6aauSHu3AQIug@cluster0.xj6r9tv.mongodb.net/dus?appName=Cluster0
MONGO_DB_NAME=dus

# ─── Redis ────────────────────────────────────────────────────────────────────
# LOCAL: use this for local redis-server
#REDIS_URL=redis://localhost:6379
# UPSTASH: no quotes — dotenv will include them literally
REDIS_URL=rediss://default:gQAAAAAAActFAAIgcDFlMzBmMDM2MGU5N2Y0ZTFkYTUwODM5YWI5NDk5NzIwMA@tidy-fly-117573.upstash.io:6379
REDIS_PASSWORD=

# ─── JWT (RS256) ──────────────────────────────────────────────────────────────
JWT_PRIVATE_KEY_PATH=/Users/apple/MyFiles/Projects/DUS/keys/private.pem
JWT_PUBLIC_KEY_PATH=/Users/apple/MyFiles/Projects/DUS/keys/public.pem
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Short code ───────────────────────────────────────────────────────────────
SHORT_CODE_LENGTH=6
SHORT_CODE_BASE_URL=http://localhost:3000

# ─── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_ANON=5
RATE_LIMIT_MAX_FREE=30
RATE_LIMIT_MAX_PRO=100

# ─── BullMQ ───────────────────────────────────────────────────────────────────
BULL_CONCURRENCY=10

# ─── GeoIP ────────────────────────────────────────────────────────────────────
GEOIP_DB_PATH=../../data/GeoLite2-Country.mmdb

# ─── Optional: Google Safe Browsing ──────────────────────────────────────────
GOOGLE_SAFE_BROWSING_API_KEY=
