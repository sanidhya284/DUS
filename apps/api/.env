# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/dus?replicaSet=rs0
MONGO_DB_NAME=dus

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ─── JWT (RS256) ──────────────────────────────────────────────────────────────
# Generate with: npm run generate-keys
JWT_PRIVATE_KEY_PATH=/Users/apple/MyFiles/Projects/DUS/keys/private.pem
JWT_PUBLIC_KEY_PATH=/Users/apple/MyFiles/Projects/DUS/keys/public.pem
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Short code ───────────────────────────────────────────────────────────────
SHORT_CODE_LENGTH=6
SHORT_CODE_BASE_URL=http://localhost:3000

# ─── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_ANON=5
RATE_LIMIT_MAX_FREE=30
RATE_LIMIT_MAX_PRO=100

# ─── BullMQ ───────────────────────────────────────────────────────────────────
BULL_CONCURRENCY=10

# ─── GeoIP ────────────────────────────────────────────────────────────────────
GEOIP_DB_PATH=../../data/GeoLite2-Country.mmdb

# ─── Optional: Google Safe Browsing ──────────────────────────────────────────
GOOGLE_SAFE_BROWSING_API_KEY=
